# ============================================================
# PORTFOLIO - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
# ============================================================

# --- Supabase (Database & Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site Configuration ---
NEXT_PUBLIC_SITE_URL=https://ingabadefrancois.vercel.app
NEXT_PUBLIC_SITE_NAME="François Leking — Portfolio"

# --- Admin Authentication ---
# Option 1: Email/Password (Supabase Auth)
# ADMIN_EMAIL=admin@francoisleking.dev
# ADMIN_PASSWORD=your-secure-password

# Option 2: OAuth (GitHub/Google) - Configure in Supabase Dashboard
# NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# --- Analytics (Optional) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=francoisleking.dev
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Email/Contact Form (Optional) ---
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL="François Leking <contact@francoisleking.dev>"
# CONTACT_EMAIL_TO=contact@francoisleking.dev

# --- reCAPTCHA / Turnstile (Optional) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxx
# TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxx

# --- Image Optimization ---
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true

# ============================================================
# LOCAL DEVELOPMENT OVERRIDES
# ============================================================
# Uncomment and modify for local development
# DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio
# REDIS_URL=redis://localhost:6379
