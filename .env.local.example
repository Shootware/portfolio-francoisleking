# ============================================================
# VARIABLES D'ENVIRONNEMENT — Portfolio François Leking
# Copie ce fichier en .env.local et remplis les valeurs
# NE JAMAIS committer .env.local sur Git !
# ============================================================

# ---- Email (Resend) ----
# Crée un compte sur https://resend.com (gratuit : 3000 emails/mois)
# Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email de destination pour les messages du formulaire de contact
CONTACT_EMAIL_TO=francoisleking@gmail.com

# ---- URL de base (prod) ----
NEXT_PUBLIC_BASE_URL=https://francoisleking.dev

# ---- Analytics (optionnel — Vercel Analytics) ----
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
